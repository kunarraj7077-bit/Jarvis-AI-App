[app]
title = JARVIS CORE
package.name = jarvis_core_apk
package.domain = org.stark.jarviscore
source.dir = .
source.include_exts = py,png,jpg,kv,json,html,css
version = 1.0
requirements = python3,kivy,requests,urllib3,chardet,idna,pyjnius
android.permissions = CAMERA, WRITE_EXTERNAL_STORAGE, READ_EXTERNAL_STORAGE, INTERNET, CALL_PHONE
orientation = portrait
android.fullscreen = 1
android.api = 33
android.minapi = 21
